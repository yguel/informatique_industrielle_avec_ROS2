<?xml version = "1.0"?>
<robot Name = "Pantograph" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- Used for fixing robot to 'base_link' -->
  <link name="world"/>

 
  <!-- Base Link -->
  <link name = "base_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/ada/ws1612/src/ecat_ros2_workshop/scara_description/urdf/meshes/base.dae"/>
      </geometry>     
      <origin xyz = "0 0 0" rpy = "1.5708 0 0"/>
    </visual>
  </link>

  <joint name="joint_base_to_pantograph" type="fixed">
     <parent link="world"/>
     <child link="base_link"/>
  </joint>  

  <!-- Link 1-->
  <link name = "link1">
    <visual>
      <geometry>
        <mesh filename="file:///home/ada/ws1612/src/ecat_ros2_workshop/scara_description/urdf/meshes/link1.dae"/>
      </geometry>     
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="joint1" type="continuous">
     <parent link="base_link"/>
     <child link="link1"/>
     <origin xyz="-0.08 -0.07 0.035" rpy="0 0 0"/>
     <axis xyz="0 0 1"/>
     <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>
 
  <!-- Link 2-->
  <link name = "link2">
    <visual>
      <geometry>
        <mesh filename="file:///home/ada/ws1612/src/ecat_ros2_workshop/scara_description/urdf/meshes/link2.dae"/>
      </geometry>     
      <origin xyz = "0 0 0" rpy = "0 0 0"/>
    </visual>
  </link>
  
  <joint name="joint2" type="continuous">
     <parent link="link1"/>
     <child link="link2"/>
     <origin xyz="0.08 0 0.054" rpy="1.5708 0 0"/>
     <axis xyz="0 1 0"/>
     <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>
  <!-- Link 3-->
  <link name = "link3">
    <visual>
      <geometry>
        <mesh filename="file:///home/ada/ws1612/src/ecat_ros2_workshop/scara_description/urdf/meshes/link4.dae"/>
      </geometry>     
      <origin xyz = "0 0 0" rpy = "0 0 0"/>
    </visual>
  </link>

  <joint name="joint3" type="continuous">
     <parent link="base_link"/>
     <child link="link3"/>
     <origin xyz="0.058 -0.07 0.035" rpy="0 0 0"/>
     <axis xyz="0 0 1"/>
     <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>
  <!-- Link 4-->
  <link name = "link4">
    <visual>
      <geometry>
        <mesh filename="file:///home/ada/ws1612/src/ecat_ros2_workshop/scara_description/urdf/meshes/link3.dae"/>
      </geometry>     
      <origin xyz = "0 0 0" rpy = "-1.57 0 0"/>
    </visual>
  </link>

  <joint name="joint4" type="continuous">
     <parent link="link3"/>
     <child link="link4"/>
     <origin xyz="0.079 0 0.053" rpy="0 0 0"/>
     <axis xyz="0 0 1"/>
     <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

</robot>

